# Copy to .env and fill in. Never commit the real .env file.

# --- Database ---
POSTGRES_DB=ragdb
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- LLM and embeddings (OpenAI-compatible by default) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Must equal the embedding model's vector size (1536 for text-embedding-3-small).
EMBEDDING_DIMENSIONS=1536

# --- Gateway ---
GATEWAY_PORT=8080

# --- Story 1: ingestion and chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Story 2: dynamic ingestion security ---
VENDOR_WEBHOOK_SECRET=change-me
# Comma-separated allowlist, for example: docs.example.com,github.com
INGEST_ALLOWED_DOMAINS=
INGEST_MAX_SIZE_MB=20

# --- Stories 3 and 4: retrieval tuning ---
RETRIEVAL_TOP_K=20
SIMILARITY_THRESHOLD=0.70
QUERY_EXPANSION_VARIANTS=3
RERANK_TOP_K=5
STITCH_TOKEN_BUDGET=2000
